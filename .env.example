# Copy this file to .env.local (which is gitignored) and fill in your values.
# Find these in the Neon Console → Auth tab / Data API section.
# Both are public client config (they ship to the browser); JWT auth + RLS
# protect the data, not the secrecy of these URLs.
VITE_NEON_AUTH_URL=https://YOUR-ENDPOINT.neonauth.YOUR-REGION.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://YOUR-ENDPOINT.apirest.YOUR-REGION.aws.neon.tech/neondb/rest/v1
