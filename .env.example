# Copy this file to .env.local (which is gitignored) and fill in your values.
# Find these in the Supabase dashboard → Project Settings → API.
# The anon key is public-safe (it ships to the browser); RLS protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
